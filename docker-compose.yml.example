# formr-mcp — the hosted (streamable-HTTP) server for a formr instance.
#
# formr signs researchers in: a client that adds https://<formr host>/mcp gets a
# 401 pointing at /.well-known/oauth-protected-resource/mcp, which names formr
# as the authorization server; the researcher signs in on formr and chooses
# the connection's scopes and runs. Every request then carries that
# connection's token, which this server checks with formr and passes on.
# No secret, credential or file is kept here.
#
# formr needs the same URL as FORMR_MCP_URL (settings mcp_url), and a formr
# release that is an OAuth server (v2.0.0-rc13 and later). formr-docker runs
# this as its docker-compose-mcp.yml layer; this file is for other setups.
#
# Usage:
#   cp docker-compose.yml.example docker-compose.yml
#   FORMR_HOST=formr.example.org docker compose up -d --build

services:
  formr-mcp:
    build:
      context: .
      dockerfile: Dockerfile
    image: formr-mcp:local
    container_name: formr-mcp
    restart: always
    read_only: true
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    environment:
      FORMR_BASE_URL: https://${FORMR_HOST}
      MCP_PUBLIC_URL: https://${FORMR_HOST}/mcp
      # what real participants' data the hosted server may read: test_only or all
      FORMR_DATA_ACCESS: test_only
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz').status==200 else 1)"]
      interval: 30s
      timeout: 3s
      retries: 3
    networks:
      - proxy
    labels:
      traefik.enable: "true"
      traefik.docker.network: proxy
      # /mcp and its resource metadata on formr's admin host, above formr's own router
      traefik.http.routers.formr-mcp.rule: Host(`${FORMR_HOST}`) && (Path(`/mcp`) || Path(`/.well-known/oauth-protected-resource/mcp`))
      traefik.http.routers.formr-mcp.priority: "100"
      traefik.http.routers.formr-mcp.entrypoints: websecure
      traefik.http.routers.formr-mcp.tls: "true"
      traefik.http.routers.formr-mcp.tls.certresolver: letsencrypt
      # No IP-reputation WAF (CrowdSec) here: every claude.ai user comes from
      # Anthropic's 160.79.104.0/21. formr's token check is the gate.
      traefik.http.routers.formr-mcp.service: formr-mcp
      traefik.http.services.formr-mcp.loadbalancer.server.port: "8000"

networks:
  proxy:
    external: true
    name: proxy
