# formr instance URL (local dev or production)
FORMR_BASE_URL=http://localhost

# HTTP request timeout in seconds (default 60). Raise this for slow or remote
# instances — run creation / structure upload / results export do real
# server-side work that can exceed the old 5s default and time out.
# FORMR_HTTP_TIMEOUT=60

# Log verbosity (default INFO). Logs go to stderr, which the MCP client
# captures. INFO logs each tool call and each formr API request (status +
# duration); DEBUG additionally surfaces raw httpx request lines.
# FORMR_MCP_LOG_LEVEL=INFO

# API credentials — create at <base_url>/admin/account#api
# Requires admin >= 2. Scopes are fixed per credential: design/edit needs
# run:read + run:write; the read tools additionally need session:read,
# data:read, file:read, survey:read. A credential may be read-only or
# limited to specific runs — `whoami` reports exactly what this token can do.
FORMR_CLIENT_ID=your_32_hex_client_id
FORMR_CLIENT_SECRET=your_64_hex_client_secret

# Participant-data access ceiling (GDPR). Hard limit on what the read tools
# may return, regardless of per-call filters:
#   test_only (default) — only test sessions (testing=1) are ever readable
#   all                 — real participant data is readable
# Leave unset for the safe default. Restart the server after changing.
# FORMR_DATA_ACCESS=test_only

# Flowchart Generator URL (used by open_flowchart tool)
# FLOWCHART_URL=https://formr-flowchart-test.pages.dev
